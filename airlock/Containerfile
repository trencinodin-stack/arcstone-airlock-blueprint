# Verified Coq 8.18.0 base image (replace with @sha256:... digest once built and pushed)
FROM coqorg/coq:8.18.0-ocaml-4.14.2-flambda

USER root

ARG CHARON_COMMIT=main
ARG AENEAS_COMMIT=main

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    CARGO_NET_OFFLINE=false \
    OPAMROOT=/home/coq/.opam \
    PATH="/opt/cargo/bin:/opt/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential pkg-config libssl-dev python3 jq m4 libgmp-dev unzip bubblewrap \
    && rm -rf /var/lib/apt/lists/* \
    && git config --global --add safe.directory '*'

# Install rustup (exact nightly is installed from Charon's pinned rust-toolchain)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none --profile minimal

# Clone Aeneas and resolve co-versioned Charon commit
RUN set -euxo pipefail \
    && mkdir -p /opt/src /opt/bin /opt/aeneas/backends/coq \
    && git clone https://github.com/AeneasVerif/aeneas.git /opt/src/aeneas \
    && git -C /opt/src/aeneas checkout "${AENEAS_COMMIT}" \
    && PINNED_CHARON="$(grep -Ev '^\s*(#|$)' /opt/src/aeneas/charon-pin | tr -d '[:space:]')" \
    && test -n "${PINNED_CHARON}" \
    && echo "Resolved PINNED_CHARON=${PINNED_CHARON}" \
    && if [ "${CHARON_COMMIT}" != "main" ] && [ "${CHARON_COMMIT}" != "${PINNED_CHARON}" ]; then \
         echo "ERROR: CHARON_COMMIT (${CHARON_COMMIT}) != resolved PINNED_CHARON (${PINNED_CHARON})"; exit 1; \
       fi \
    && git clone https://github.com/AeneasVerif/charon.git /opt/src/charon \
    && git -C /opt/src/charon checkout "${PINNED_CHARON}" \
    && echo "${PINNED_CHARON}" > /opt/aeneas/charon-pin \
    && git -C /opt/src/aeneas rev-parse HEAD > /opt/aeneas/aeneas-pin

# Install Charon's exact pinned Rust nightly toolchain + compiler internals, build Charon, and reclaim ~7.5GB Rust target artifacts
RUN set -euxo pipefail \
    && cd /opt/src/charon \
    && if [ -f rust-toolchain.template ] && [ ! -f rust-toolchain ] && [ ! -f rust-toolchain.toml ]; then \
         cp rust-toolchain.template rust-toolchain; \
       fi \
    && rustup show active-toolchain \
    && rustup show active-toolchain | awk '{print $1}' > /opt/aeneas/rust-nightly-pin \
    && rustup component add rustfmt \
    && make build-charon-rust \
    && cp bin/* /opt/bin/ \
    && cd / \
    && rm -rf /opt/src/charon/charon/target /opt/cargo/registry/cache /opt/cargo/registry/src /opt/cargo/git/checkouts

# Replace 4.14.2 switch with OCaml 5.2.0 + Coq 8.18.0 switch, install Charon OCaml lib, build Aeneas, and clean caches
RUN set -euxo pipefail \
    && opam switch remove -y 4.14.2+flambda || true \
    && opam update default coq-released \
    && opam switch create aeneas-5.2 ocaml-base-compiler.5.2.0 \
    && eval $(opam env --switch=aeneas-5.2 --set-switch) \
    && CHARON_OPAM_FILES="$(find /opt/src/charon -maxdepth 3 -name '*.opam')" \
    && AENEAS_OPAM_FILES="$(find /opt/src/aeneas -maxdepth 2 -name '*.opam')" \
    && opam install -y coq.8.18.0 \
    && opam install -y --deps-only ${CHARON_OPAM_FILES} ${AENEAS_OPAM_FILES} \
    && opam install -y ${CHARON_OPAM_FILES} \
    && cd /opt/src/aeneas \
    && make -C src \
    && install -m 0755 src/_build/default/bin/main.exe /opt/bin/aeneas \
    && cp -r backends/coq/* /opt/aeneas/backends/coq/ \
    && cd / \
    && rm -rf /opt/src/charon /opt/src/aeneas \
    && opam clean -a -c -s --logs

# Expose OCaml 5.2.0 + Coq 8.18.0 switch binaries on PATH for runtime container execution
ENV PATH="/home/coq/.opam/aeneas-5.2/bin:/opt/cargo/bin:/opt/bin:${PATH}" \
    OPAMSWITCH=aeneas-5.2 \
    CARGO_NET_OFFLINE=true \
    CARGO_INCREMENTAL=0 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    SOURCE_DATE_EPOCH=0

RUN chmod -R a+rX /opt/cargo /opt/rustup /opt/bin /opt/aeneas /home/coq/.opam

USER 65532:65532
WORKDIR /work
