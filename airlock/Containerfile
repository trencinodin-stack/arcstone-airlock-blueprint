# Coq 8.18.0 base image (replace with @sha256:... digest once built and pushed)
FROM coqorg/coq:8.18.0-ocaml-4.14.2-flambda

USER root

ARG CHARON_COMMIT=main
ARG AENEAS_COMMIT=main

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    CARGO_NET_OFFLINE=false \
    PATH="/opt/cargo/bin:/opt/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential pkg-config libssl-dev python3 jq m4 libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

# Install rustup (exact nightly is installed from Charon's pinned rust-toolchain)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none --profile minimal

# Clone Aeneas and resolve co-versioned Charon commit
RUN set -euxo pipefail \
    && mkdir -p /opt/src /opt/bin /opt/aeneas/backends/coq \
    && git clone https://github.com/AeneasVerif/aeneas.git /opt/src/aeneas \
    && git -C /opt/src/aeneas checkout "${AENEAS_COMMIT}" \
    && PINNED_CHARON="$(python3 - <<'PY'
import json, pathlib, re, subprocess

root = pathlib.Path("/opt/src/aeneas")
pin_file = root / "charon-pin"
flake_lock = root / "flake.lock"
flake_nix = root / "flake.nix"

if pin_file.exists():
    print(pin_file.read_text().strip())
elif flake_lock.exists():
    data = json.loads(flake_lock.read_text())
    nodes = data.get("nodes", {})
    charon_node = nodes.get("charon") or next((v for k, v in nodes.items() if k.startswith("charon")), None)
    if charon_node and "locked" in charon_node and "rev" in charon_node["locked"]:
        print(charon_node["locked"]["rev"])
    else:
        raise SystemExit("charon rev not found in flake.lock")
elif flake_nix.exists():
    m = re.search(r"AeneasVerif/charon(?:/|\?rev=)([0-9a-f]{7,40})", flake_nix.read_text())
    if m:
        print(m.group(1))
    else:
        raise SystemExit("charon rev not found in flake.nix")
else:
    out = subprocess.check_output(["git", "-C", str(root), "ls-tree", "HEAD", "charon"], text=True).strip()
    if out:
        print(out.split()[2])
    else:
        raise SystemExit("Could not resolve Charon commit from Aeneas repo")
PY
)" \
    && echo "Resolved PINNED_CHARON=${PINNED_CHARON}" \
    && if [ "${CHARON_COMMIT}" != "main" ] && [ "${CHARON_COMMIT}" != "${PINNED_CHARON}" ]; then \
         echo "ERROR: CHARON_COMMIT (${CHARON_COMMIT}) != resolved PINNED_CHARON (${PINNED_CHARON})"; exit 1; \
       fi \
    && git clone https://github.com/AeneasVerif/charon.git /opt/src/charon \
    && git -C /opt/src/charon checkout "${PINNED_CHARON}" \
    && echo "${PINNED_CHARON}" > /opt/aeneas/charon-pin \
    && git -C /opt/src/aeneas rev-parse HEAD > /opt/aeneas/aeneas-pin
# Install Charon's exact pinned Rust nightly toolchain + compiler internals and build Charon
RUN cd /opt/src/charon \
    && if [ -f rust-toolchain.template ] && [ ! -f rust-toolchain ] && [ ! -f rust-toolchain.toml ]; then \
         cp rust-toolchain.template rust-toolchain; \
       fi \
    && rustup show active-toolchain \
    && rustup show active-toolchain | awk '{print $1}' > /opt/aeneas/rust-nightly-pin \
    && make build-charon-rust \
    && cp bin/charon /opt/bin/charon

# Install Aeneas OCaml dependencies and build Aeneas
RUN eval $(opam env) \
    && cd /opt/src/aeneas \
    && opam update \
    && opam install -y src --deps-only \
    && make \
    && cp bin/aeneas /opt/bin/aeneas \
    && cp -r backends/coq/* /opt/aeneas/backends/coq/

# Switch to strict offline mode for runtime container execution
ENV CARGO_NET_OFFLINE=true \
    CARGO_INCREMENTAL=0 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    SOURCE_DATE_EPOCH=0

RUN chmod -R a+rX /opt/cargo /opt/rustup /opt/bin /opt/aeneas

USER 65532:65532
WORKDIR /work
