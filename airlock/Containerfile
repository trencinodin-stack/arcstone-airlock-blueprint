# Digest-pinned Coq 8.18.0 base image (replace digest during image qualification)
FROM coqorg/coq:8.18.0-ocaml-4.14.1-flambda

USER root

ARG RUST_NIGHTLY=nightly-2024-11-01
ARG CHARON_COMMIT=main
ARG AENEAS_COMMIT=main

ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    RUSTUP_TOOLCHAIN=${RUST_NIGHTLY} \
    CARGO_NET_OFFLINE=false \
    PATH="/opt/cargo/bin:/opt/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git build-essential pkg-config libssl-dev python3 jq \
    && rm -rf /var/lib/apt/lists/*

# Install pinned Rust nightly with compiler internals required by Charon
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "${RUST_NIGHTLY}" --profile minimal \
    && rustup component add --toolchain "${RUST_NIGHTLY}" rustc-dev llvm-tools-preview rust-src

# Clone Aeneas and verify co-versioned charon-pin match
RUN mkdir -p /opt/src /opt/bin /opt/aeneas/backends/coq \
    && git clone https://github.com/AeneasVerif/aeneas.git /opt/src/aeneas \
    && git -C /opt/src/aeneas checkout "${AENEAS_COMMIT}" \
    && PINNED_CHARON="$(tr -d '[:space:]' < /opt/src/aeneas/charon-pin)" \
    && if [ "${CHARON_COMMIT}" != "main" ] && [ "${CHARON_COMMIT}" != "${PINNED_CHARON}" ]; then \
         echo "ERROR: CHARON_COMMIT (${CHARON_COMMIT}) != aeneas/charon-pin (${PINNED_CHARON})"; exit 1; \
       fi \
    && git clone https://github.com/AeneasVerif/charon.git /opt/src/charon \
    && git -C /opt/src/charon checkout "${PINNED_CHARON}"

# Build Charon and Aeneas
RUN cd /opt/src/charon && cargo build --release && cp target/release/charon /opt/bin/charon
RUN eval $(opam env) && cd /opt/src/aeneas && make && cp bin/aeneas /opt/bin/aeneas \
    && cp -r backends/coq/* /opt/aeneas/backends/coq/

# Switch to strict offline mode for runtime container execution
ENV CARGO_NET_OFFLINE=true \
    CARGO_INCREMENTAL=0 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    SOURCE_DATE_EPOCH=0

RUN chmod -R a+rX /opt/cargo /opt/rustup /opt/bin /opt/aeneas

USER 65532:65532
WORKDIR /work
